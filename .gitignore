# ==========================================================================
# Scripting Library - ignore rules
#
# Tracked in this repository: every script (bash/, lua/, powershell/, python/,
# ruby/, vba/ - each folder holds one script plus its README.md), the Vue
# showcase (src/, public/, configs), the generator (tools/) and the top-level
# README.  Everything below is build output, generated data or tool/editor
# cruft.
# ==========================================================================

# --- Showcase app (Vue + Vite) -------------------------------------------
# dist/ is the GitHub Pages artifact and public/scripts-data.js is generated by
# tools/generate-data.mjs, so neither is ever committed.
node_modules/
dist/
public/scripts-data.js
.vite/
*.tsbuildinfo
coverage/
npm-debug.log*

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- .NET ---------------------------------------------------------------
bin/
obj/

# --- Editors and OS cruft -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.log
.DS_Store
Thumbs.db
desktop.ini
